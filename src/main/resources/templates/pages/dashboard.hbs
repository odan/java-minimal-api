{{#partial "title"}}Dashboard{{/partial}}

{{#partial "head"}}
    <link rel="stylesheet" href="/css/dashboard.css">
{{/partial}}

{{#partial "content"}}
    <div class="row row-deck row-cards">

        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">Revenue</div>
                    <div class="h1 mb-3">$42,890</div>
                    <div class="text-success">
                        +12.5% compared to last month
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">Users</div>
                    <div class="h1 mb-3">18,240</div>
                    <div class="text-success">
                        +1,280 new users
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">Orders</div>
                    <div class="h1 mb-3">3,482</div>
                    <div class="text-warning">
                        216 orders pending
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">Conversion Rate</div>
                    <div class="h1 mb-3">6.8%</div>
                    <div class="text-danger">
                        -0.9% compared to last week
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Revenue Overview</h3>
                </div>
                <div class="card-body">
                    <div id="chart-revenue" class="chart-lg"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Traffic Sources</h3>
                </div>
                <div class="card-body">
                    <div id="chart-traffic" class="chart-lg"></div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Orders by Status</h3>
                </div>
                <div class="card-body">
                    <div id="chart-orders" class="chart-md"></div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">User Growth</h3>
                </div>
                <div class="card-body">
                    <div id="chart-users" class="chart-md"></div>
                </div>
            </div>
        </div>

        <div class="col-md-12 col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Performance</h3>
                </div>
                <div class="card-body">
                    <div id="chart-performance" class="chart-md"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Recent Activity</h3>
                </div>

                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                        <tr>
                            <th>Activity</th>
                            <th>User</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th class="w-1"></th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr>
                            <td>
                                <div class="font-weight-medium">New order created</div>
                                <div class="text-secondary">Order #ORD-10928</div>
                            </td>
                            <td>Anna Keller</td>
                            <td>
                                <span class="badge bg-success me-1"></span>
                                Completed
                            </td>
                            <td>Today, 09:42</td>
                            <td>
                                <a href="#" class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <div class="font-weight-medium">Invoice generated</div>
                                <div class="text-secondary">Invoice #INV-7821</div>
                            </td>
                            <td>Markus Weber</td>
                            <td>
                                <span class="badge bg-info me-1"></span>
                                Sent
                            </td>
                            <td>Today, 08:15</td>
                            <td>
                                <a href="#" class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <div class="font-weight-medium">Payment failed</div>
                                <div class="text-secondary">Transaction #TX-44291</div>
                            </td>
                            <td>Sofia Martins</td>
                            <td>
                                <span class="badge bg-danger me-1"></span>
                                Failed
                            </td>
                            <td>Yesterday, 18:03</td>
                            <td>
                                <a href="#" class="btn btn-sm btn-outline-danger">
                                    Review
                                </a>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <div class="font-weight-medium">User account updated</div>
                                <div class="text-secondary">Profile settings changed</div>
                            </td>
                            <td>Daniel Schmid</td>
                            <td>
                                <span class="badge bg-warning me-1"></span>
                                Pending
                            </td>
                            <td>Yesterday, 14:27</td>
                            <td>
                                <a href="#" class="btn btn-sm btn-outline-warning">
                                    Check
                                </a>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Tasks</h3>
                </div>
                <div class="list-group list-group-flush">
                    <div class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <input class="form-check-input" type="checkbox" checked>
                            </div>
                            <div class="col">
                                <strong>Review monthly report</strong>
                                <div class="text-secondary">Completed</div>
                            </div>
                        </div>
                    </div>

                    <div class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <input class="form-check-input" type="checkbox">
                            </div>
                            <div class="col">
                                <strong>Approve pending orders</strong>
                                <div class="text-secondary">Due today</div>
                            </div>
                        </div>
                    </div>

                    <div class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <input class="form-check-input" type="checkbox">
                            </div>
                            <div class="col">
                                <strong>Prepare sales forecast</strong>
                                <div class="text-secondary">Due this week</div>
                            </div>
                        </div>
                    </div>

                    <div class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <input class="form-check-input" type="checkbox">
                            </div>
                            <div class="col">
                                <strong>Update dashboard widgets</strong>
                                <div class="text-secondary">Backlog</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
{{/partial}}

{{#partial "scripts"}}
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            new ApexCharts(document.querySelector("#chart-revenue"), {
                chart: {
                    type: "area",
                    height: 320,
                    toolbar: {
                        show: false
                    }
                },
                series: [
                    {
                        name: "Revenue",
                        data: [12000, 18000, 15000, 22000, 28000, 26000, 34000, 39000, 42000]
                    }
                ],
                xaxis: {
                    categories: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep"]
                },
                dataLabels: {
                    enabled: false
                },
                stroke: {
                    curve: "smooth"
                }
            }).render();

            new ApexCharts(document.querySelector("#chart-traffic"), {
                chart: {
                    type: "donut",
                    height: 320
                },
                series: [44, 27, 18, 11],
                labels: ["Organic", "Direct", "Referral", "Social"]
            }).render();

            new ApexCharts(document.querySelector("#chart-orders"), {
                chart: {
                    type: "bar",
                    height: 260,
                    toolbar: {
                        show: false
                    }
                },
                series: [
                    {
                        name: "Orders",
                        data: [1480, 920, 640, 216]
                    }
                ],
                xaxis: {
                    categories: ["Completed", "Processing", "Shipped", "Pending"]
                },
                plotOptions: {
                    bar: {
                        borderRadius: 4,
                        horizontal: true
                    }
                }
            }).render();

            new ApexCharts(document.querySelector("#chart-users"), {
                chart: {
                    type: "line",
                    height: 260,
                    toolbar: {
                        show: false
                    }
                },
                series: [
                    {
                        name: "Users",
                        data: [9800, 10400, 11300, 12100, 13800, 14900, 16200, 17400, 18240]
                    }
                ],
                xaxis: {
                    categories: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep"]
                },
                stroke: {
                    curve: "smooth"
                }
            }).render();

            new ApexCharts(document.querySelector("#chart-performance"), {
                chart: {
                    type: "radialBar",
                    height: 260
                },
                series: [76],
                labels: ["Performance"],
                plotOptions: {
                    radialBar: {
                        hollow: {
                            size: "68%"
                        },
                        dataLabels: {
                            value: {
                                formatter: function (value) {
                                    return value + "%";
                                }
                            }
                        }
                    }
                }
            }).render();
        });
    </script>

    <script type="module" src="/js/dashboard.js"></script>
{{/partial}}

{{> layouts/main}}
